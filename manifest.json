{
  "manifest_version": 3,
  "name": "MDict Side Panel",
  "version": "1.0.0",
  "description": "Look up words in your own MDict dictionaries (.mdx/.mdd) from the browser side panel.",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "contextMenus", "storage", "unlimitedStorage"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "MDict — open the dictionary panel",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "open-panel": {
      "description": "Open the MDict side panel"
    }
  },
  "sandbox": {
    "pages": ["src/viewer.html"]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'",
    "sandbox": "sandbox allow-scripts allow-popups allow-modals; script-src 'self' 'unsafe-inline'; child-src 'self' blob:;"
  }
}
